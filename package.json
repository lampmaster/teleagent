{
  "name": "teleagent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file=.env dist/main.js",
    "start:debug": "AGENT_DEBUG=1 node --env-file=.env dist/main.js",
    "dev": "node --env-file=.env --watch dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "grammy": "^1.30.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.6.0"
  }
}
